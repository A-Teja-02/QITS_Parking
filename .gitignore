# Root level gitignore to ignore build outputs, virtual environments, and node_modules

# Node.js dependencies and build output
client/node_modules/
client/dist/
client/dist-ssr/
client/.local

# Python virtual environment and caches
server/venv/
server/__pycache__/
server/**/*.pyc
server/.pytest_cache/

# OS specific files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env.*
!.env.example

# Firebase service account private key (never commit)
**/firebase-service-account.json
**/*firebase-adminsdk*.json

# Android build output
android/.gradle/
android/app/build/
android/local.properties
android/keystore.properties

# AI Vision backend runtime data (camera configs may contain RTSP passwords; evidence photos)
backend/data/
backend/captures/
backend/**/__pycache__/
.backup_before_cctv_rework/

# Databases and runtime data - never commit (employee data, password hashes, camera passwords)
*.db
*.db-journal
*.imported
backend/cameras.json
backend/data/
backend/captures/
backend/**/__pycache__/
server/uploads/
server/*.json.key
server/*firebase-adminsdk*.json
android/app/google-services.json
android/keystore.properties
*.jks
*.keystore
android/local.properties
android/.gradle/
android/build/
android/app/build/
.backup_before_cctv_rework/
client/vite.config.ts.timestamp-*
